{
  "name": "@oleh-ob/cs-styles",
  "version": "0.7.31",
  "description": "css framework for semantic HTML",
  "main": "dist/cs-styles.min.css",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:prefix && npm run build:minify && npm run build:banner",
    "build:css": "sass --no-source-map --style expanded --no-error-css scss/:dist/",
    "build:prefix": "lightningcss --browserslist dist/cs-styles.css -o dist/cs-styles.css",
    "build:minify": "lightningcss --browserslist --minify dist/cs-styles.css -o dist/cs-styles.min.css",
    "build:banner": "node --input-type=commonjs -e \"const fs=require('fs'),f='dist/cs-styles.min.css';fs.writeFileSync(f,fs.readFileSync('scss/_copyright.scss')+fs.readFileSync(f))\"",
    "dev": "npm run build:css -- --watch",
    "check:diff": "git diff --no-index --exit-code .baseline/cs-styles.css dist/cs-styles.css",
    "lint":"postcss \"scss/**/*.scss\" --replace && stylelint --fix \"scss/**/*.scss\"",
    "theme": "node m3theme-loader.js src=material-theme-default.json scss=scss/settings/_themes_colors.scss",
    "generate-theme": "node m3theme-generator.js \"#096d8c\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/si9urd/cs-styles.git"
  },
  "keywords": [
    "css",
    "css-framework",
    "lightweight",
    "minimalistic"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "browserslist": [
    "defaults"
  ],
  "author": "Oleh Obydonov",
  "license": "MIT",
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "css-declaration-sorter": "^7.2.0",
    "lightningcss-cli": "^1.33.0",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.3.3",
    "sass": "^1.79.4",
    "standard": "^17.1.2",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.2.0"
  },
  "bugs": {
    "url": "https://github.com/si9urd/cs-styles/issues"
  },
  "homepage": "https://github.com/si9urd/cs-styles#readme"
}
